{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/**/*.mjs": {
      "includeFiles": ["data/fantasy_football.sqlite", "data/intelligence-feed.json", "data/intelligence-sources.json"],
      "maxDuration": 60
    }
  }
}
