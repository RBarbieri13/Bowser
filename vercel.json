{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/client",
  "git": {
    "deploymentEnabled": {
      "fantasy-news-data": false
    }
  },
  "functions": {
    "api/**/*.mjs": {
      "includeFiles": "{data/*.{sqlite,json},db/migrations/*.sql}",
      "maxDuration": 180
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/fantasy-news",
      "destination": "/api/v1/intelligence-feed?resource=fantasy-news"
    },
    {
      "source": "/api/v1/schedule",
      "destination": "/api/v1/meta?resource=schedule"
    },
    {
      "source": "/api/v1/dfs-lineup",
      "destination": "/api/v1/meta?view=dfs-lineup"
    },
    {
      "source": "/api/v1/auth/yahoo/:action",
      "destination": "/api/v1/yahoo?action=:action"
    },
    {
      "source": "/api/v1/player-identity",
      "destination": "/api/v1/player-profile?resource=identity"
    },
    {
      "source": "/api/v1/dfs-archive",
      "destination": "/api/v1/player-profile?resource=archive"
    }
  ]
}
